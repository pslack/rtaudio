<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ca.mcgill.rtaudio</groupId>
        <artifactId>rtaudio-parent</artifactId>
        <version>8.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>rtaudio-core</artifactId>
    <version>8.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <dependencies>
    </dependencies>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!-- pass this as a -D option in the maven command to point to the base of the cmake binary build dir -->
        <!-- it can be a full path or relative to the base directory containing this project pom.xml -->
        <cmake.binary.build.dir>cmake-build-debug</cmake.binary.build.dir>
        <rtaudio.native.library.path>cmake-build-debug</rtaudio.native.library.path>

    </properties>

    <build>
        <sourceDirectory>${cmake.binary.build.dir}/java</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-native-library</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${rtaudio.native.library.path}</directory>
                                    <targetPath>lib/${os.detected.name}/${os.detected.arch}</targetPath>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>librtaudio.dylib</include>
                                        <include>librtaudiojava.jnilib</include>
                                        <include>*.so</include>
                                        <include>*.dll</include>
                                        <include>*.dylib</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


         <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <id>sign</id>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <storetype>${keystore.type}</storetype>
                            <keystore>${gnarly.keystore.path}</keystore>
                            <alias>${gnarly.keystore.alias}</alias>
                            <storepass>${gnarly.keystore.password}</storepass>
                            <arguments>
                                <argument>-tsa</argument>
                                <argument>${gnarly.tsa}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>

            </plugin>
        </plugins>
    </build>


</project>
